# Copia este archivo a .env.local y completa los valores.
# .env y .env.local están en .gitignore: nunca subas tus secretos al repositorio.

# ─── Base de datos (Neon) ───────────────────────────────────────────
# Neon → Connect → Connection string (con "Connection pooling"). Debe empezar con postgresql://
# (No uses la URL de la Data API https://…/rest/v1)
# Si no se define, el sitio público muestra datos de ejemplo.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ─── Auth.js (next-auth v5) ─────────────────────────────────────────
# Genera uno con: npx auth secret
AUTH_SECRET=""

# Credenciales OAuth de Google (Google Cloud Console → Clientes → Aplicación web)
# URI de redirección: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Único correo autorizado para entrar a /admin
ADMIN_EMAIL="tu-correo@gmail.com"

# ─── Opcional ───────────────────────────────────────────────────────
# URL pública del sitio (SEO, sitemap y Open Graph). En Vercel se detecta sola.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary: subida de imágenes desde el admin (foto de perfil y portadas).
# Dashboard de Cloudinary → Settings → API Keys. Sin estas variables, las imágenes se cargan por URL.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# (Alternativa: CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME")
